# Streamlit Community Cloud: paste the content of this file (with your values) into
# App settings -> Secrets. Top-level keys become environment variables, which is how secagents reads them.

SECAGENTS_PUBLIC = "1"          # per-visitor isolation, no server folders, no auto-approve, shared-key budget
OPENROUTER_API_KEY = ""         # the host's key: visitors use it until their allowance runs out
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""
SESSION_TOKEN_CAP = "60000"     # model tokens one visitor session may spend on the host's key
DAILY_TOKEN_CAP = "300000"      # model tokens all visitors together may spend per day
