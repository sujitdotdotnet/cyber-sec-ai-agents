# Streamlit Community Cloud: paste this (with your values) into App settings -> Secrets.
# Top-level keys become environment variables, which is how secagents reads them. Keep them ABOVE the [auth] block.

SECAGENTS_PUBLIC = "1"                  # guest / sign-in gate, per-visitor isolation, spending limits, no server folders

# The host's model key: visitors use it until their allowance runs out (a key they paste themselves is never counted).
OPENROUTER_API_KEY = ""
# ANTHROPIC_API_KEY = ""
# OPENAI_API_KEY = ""

# Storage that survives restarts: a Postgres URL (Neon / Supabase free tier). Without it, signed-in users' data is kept
# on the host's temporary disk and is lost on restart.
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Who may sign in (leave both out to allow any verified account).
# ALLOWED_EMAILS = "you@example.com,teammate@example.com"
# ALLOWED_EMAIL_DOMAINS = "example.com"

# Limits, in model tokens on the host's key (defaults shown)
# SESSION_TOKEN_CAP = "60000"           # one guest session
# GUEST_DAILY_TOKEN_CAP = "80000"       # one guest client per day (stops "open a new tab" resets)
# USER_DAILY_TOKEN_CAP = "250000"       # one signed-in user per day
# DAILY_TOKEN_CAP = "600000"            # everyone together per day
# RATE_PER_MINUTE = "20"                # model calls per visitor per minute
# GUEST_DAILY_DOWNLOADS = "3"           # GitHub / Drive fetches per day
# USER_DAILY_DOWNLOADS = "15"

# Sign-in (Streamlit's built-in OpenID Connect). Example with Google: create an OAuth client at
# console.cloud.google.com -> APIs & Services -> Credentials, and add the redirect URI below to it.
[auth]
redirect_uri = "https://YOUR-APP.streamlit.app/oauth2callback"   # locally: http://localhost:8501/oauth2callback
cookie_secret = "a-long-random-string"                           # e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
client_id = "YOUR_CLIENT_ID.apps.googleusercontent.com"
client_secret = "YOUR_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
