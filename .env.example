# Copy to .env and fill in the keys you have. Any one provider is enough; with none the
# agents run in rule-based mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Providers are tried in this order; a failure or refusal falls through to the next one.
LLM_PROVIDER_ORDER=openrouter,anthropic,openai
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Used for RAG embeddings when OPENAI_API_KEY is set; otherwise a local embedding is used.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SECAGENTS_OFFLINE=1   # force rule-based mode (no API calls)

# ---- Agent tab ---------------------------------------------------------------------------------------
# MEMORY_DB=.memory/memory.db      # SQLite file with chats and remembered facts
# MCP_CONFIG=mcp_servers.json      # extra MCP servers the agent can use (Claude Desktop format; "_name" = disabled)
# AGENT_MAX_STEPS=6                # model calls per question
# AGENT_TURN_TOKENS=40000          # tokens per question

# ---- Public deployment (Streamlit Community Cloud) -----------------------------------------------------------
# On Streamlit Cloud these go in the Secrets box; see .streamlit/secrets.toml.example for the sign-in ([auth]) block.
# SECAGENTS_PUBLIC=1               # guest / sign-in gate, per-visitor isolation, spending limits
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require   # data survives restarts (Neon / Supabase)
# ALLOWED_EMAILS=you@example.com   # optional access list; ALLOWED_EMAIL_DOMAINS=example.com
# SESSION_TOKEN_CAP=60000          # guest session, tokens on YOUR key (a typed key is never counted)
# GUEST_DAILY_TOKEN_CAP=80000      # per guest client per day
# USER_DAILY_TOKEN_CAP=250000      # per signed-in user per day
# DAILY_TOKEN_CAP=600000           # everyone together per day
# RATE_PER_MINUTE=20               # model calls per visitor per minute
# GUEST_DAILY_DOWNLOADS=3          # GitHub / Drive fetches per day (USER_DAILY_DOWNLOADS=15)
