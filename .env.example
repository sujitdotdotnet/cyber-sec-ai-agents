# Copy to .env and fill in the keys you have. Any one provider is enough; with none the
# agents run in rule-based mode.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Providers are tried in this order; a failure or refusal falls through to the next one.
LLM_PROVIDER_ORDER=openrouter,anthropic,openai
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
OPENAI_MODEL=gpt-4.1-mini
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# Used for RAG embeddings when OPENAI_API_KEY is set; otherwise a local embedding is used.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# SECAGENTS_OFFLINE=1   # force rule-based mode (no API calls)

# ---- Agent tab ---------------------------------------------------------------------------------------
# MEMORY_DB=.memory/memory.db      # SQLite file with chats and remembered facts
# MCP_CONFIG=mcp_servers.json      # extra MCP servers the agent can use (Claude Desktop format; "_name" = disabled)
# AGENT_MAX_STEPS=6                # model calls per question
# AGENT_TURN_TOKENS=40000          # tokens per question

# ---- Public deployment (Streamlit Community Cloud) -----------------------------------------------------------
# SECAGENTS_PUBLIC=1               # per-visitor isolation; no server folders; no auto-approve; shared-key budget
# SESSION_TOKEN_CAP=60000          # tokens one visitor may spend on YOUR key (their own typed key is not counted)
# DAILY_TOKEN_CAP=300000           # tokens all visitors may spend on your key per day
